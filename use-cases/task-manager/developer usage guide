## 5) Example Code (Python)

### Install dependency
```bash
pip install requests
```

### Minimal integration example
```python
import requests

BASE_URL = "https://api.example.com"
REGISTER_URL = f"{BASE_URL}/api/users/register"

payload = {
    "username": "alice",
    "email": "alice@example.com",
    "password": "s3cureP@ssw0rd"
}

response = requests.post(
    REGISTER_URL,
    json=payload,
    headers={"Content-Type": "application/json"},
    timeout=10
)

print("Status:", response.status_code)
print("Body:", response.json())
```

### Production-oriented error handling example
```python
import requests
from typing import Dict, Any

BASE_URL = "https://api.example.com"
REGISTER_URL = f"{BASE_URL}/api/users/register"


def register_user(username: str, email: str, password: str) -> Dict[str, Any]:
    payload = {
        "username": username,
        "email": email,
        "password": password,
    }

    try:
        resp = requests.post(
            REGISTER_URL,
            json=payload,
            headers={"Content-Type": "application/json"},
            timeout=10,
        )

        # Defensive parse in case non-JSON response is returned on errors
        try:
            body = resp.json()
        except ValueError:
            body = {"error": "Invalid response", "message": "Non-JSON response from server"}

        if resp.status_code == 201:
            return {
                "ok": True,
                "user": body.get("user"),
                "message": body.get("message", "User registered successfully"),
            }

        if resp.status_code in (400, 409):
            return {
                "ok": False,
                "retryable": False,
                "error": body.get("error", "Request error"),
                "message": body.get("message", "Please correct your input and try again."),
                "status": resp.status_code,
            }

        if resp.status_code >= 500:
            return {
                "ok": False,
                "retryable": True,
                "error": body.get("error", "Server error"),
                "message": body.get("message", "Please try again later."),
                "status": resp.status_code,
            }

        return {
            "ok": False,
            "retryable": False,
            "error": "Unexpected status",
            "message": f"Unhandled status code: {resp.status_code}",
            "status": resp.status_code,
        }

    except requests.Timeout:
        return {
            "ok": False,
            "retryable": True,
            "error": "Timeout",
            "message": "Request timed out. Please retry.",
        }
    except requests.RequestException as exc:
        return {
            "ok": False,
            "retryable": True,
            "error": "Network error",
            "message": str(exc),
        }


if __name__ == "__main__":
    result = register_user("alice", "alice@example.com", "s3cureP@ssw0rd")
    print(result)
```

